# HealthVerse — Environment Variables
# Copy this file to .env and fill in values

# App Configuration
VITE_APP_NAME=HealthVerse
VITE_APP_VERSION=1.0.0

# Firebase Configuration (Add your Firebase Console project keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase Credentials (Backup / Secondary)
VITE_SUPABASE_URL=https://aywozrmnjecwqlpzrjka.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Maps (Optional Mapbox integration)
# VITE_MAPBOX_TOKEN=your_mapbox_token_here
