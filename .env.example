# HealthVerse — Environment Variables
# Copy this file to .env and fill in values

# App Configuration
VITE_APP_NAME=HealthVerse
VITE_APP_VERSION=1.0.0

# Firebase Configuration (Add your Firebase Console project keys)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase Credentials (Backup / Secondary)
VITE_SUPABASE_URL=https://aywozrmnjecwqlpzrjka.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Maps (Optional Mapbox integration)
# VITE_MAPBOX_TOKEN=your_mapbox_token_here


# ============================================
# PayPal Sandbox Checkout (Hackathon Feature)
# ============================================
# Safe for client bundle: PayPal Sandbox Client ID loaded dynamically by JS SDK
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
# Demo INR -> USD conversion rate displayed before Sandbox charge
VITE_INR_PER_USD=85

# Server-only PayPal REST credentials (Vercel / .env.local ONLY - never prefix with VITE_)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENV=sandbox

# ============================================
# Server-only AI Provider (Vercel / .env.local ONLY)
# ============================================
# Provider: "gemini" or "anthropic"
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_api_key_here
AI_MODEL=gemini-3.5-flash
